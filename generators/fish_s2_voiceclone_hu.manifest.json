{
  "id": "fish_s2_voiceclone_hu",
  "name": "Fish S2 — Hungarian voice clone",
  "backend": "comfyui",
  "graph": "fish_s2_voiceclone_hu_workflow.json",

  "produces": "audio",
  "consumes": [
    { "type": "text", "role": "script", "required": true, "sources": ["inline", "notes_file", "text_clip"] },
    { "type": "audio", "role": "voice_reference", "required": true }
  ],
  "surfaces": ["media_browser", "audio_track_empty", "text_clip_context_menu"],

  "duration": "discovered",
  "default_variants": 1,

  "requires": ["FishS2VoiceCloneTTS", "LoadAudio", "SaveAudio"],

  "outputs": [{ "key": "audio", "type": "audio", "node": "5" }],

  "params": [
    { "key": "script", "label": "Script", "type": "text", "multiline": true, "bind": "/3/inputs/text" },

    {
      "key": "voice_reference",
      "label": "Voice sample",
      "type": "audio",
      "required": true,
      "bind": "/2/inputs/audio",
      "transport": "upload_audio"
    },

    {
      "key": "language",
      "type": "enum",
      "options": ["hu", "en"],
      "default": "hu",
      "bind": "/3/inputs/language"
    },

    { "key": "seed", "type": "seed", "bind": "/3/inputs/seed" },

    {
      "key": "temperature",
      "type": "float",
      "min": 0.1,
      "max": 1.5,
      "step": 0.05,
      "default": 0.65,
      "bind": "/3/inputs/temperature"
    },

    {
      "key": "top_p",
      "label": "Top-p",
      "type": "float",
      "min": 0.1,
      "max": 1,
      "step": 0.05,
      "default": 0.8,
      "bind": "/3/inputs/top_p"
    },

    {
      "key": "repetition_penalty",
      "type": "float",
      "min": 1,
      "max": 2,
      "step": 0.05,
      "default": 1.15,
      "bind": "/3/inputs/repetition_penalty"
    },

    {
      "key": "chunk_length",
      "label": "Chunk length",
      "type": "int",
      "min": 20,
      "max": 400,
      "default": 150,
      "bind": "/3/inputs/chunk_length"
    }
  ],

  "presets": []
}
