{
  "id": "fish_s2_narration",
  "name": "Fish S2 — narration",
  "backend": "comfyui",
  "graph": "fish_s2_narration_workflow.json",
  "produces": "audio",
  "consumes": [
    {
      "type": "text",
      "role": "script",
      "required": true,
      "sources": ["inline", "notes_file", "text_clip"]
    }
  ],
  "surfaces": ["timeline", "browser"],
  "duration": "discovered",
  "default_variants": 1,
  "requires": ["FishS2TTS", "SaveAudio"],
  "outputs": [
    {
      "key": "audio",
      "type": "audio",
      "node": "2"
    }
  ],
  "params": [
    {
      "key": "script",
      "label": "Script",
      "type": "text",
      "multiline": true,
      "bind": "/1/inputs/text"
    },
    {
      "key": "language",
      "label": "Language",
      "type": "enum",
      "options": ["hu", "en"],
      "default": "hu",
      "bind": "/1/inputs/language"
    },
    {
      "key": "seed",
      "type": "seed",
      "bind": "/1/inputs/seed"
    },
    {
      "key": "temperature",
      "label": "Temperature",
      "type": "float",
      "min": 0.1,
      "max": 1.5,
      "step": 0.05,
      "default": 0.75,
      "bind": "/1/inputs/temperature"
    },
    {
      "key": "top_p",
      "label": "Top-p",
      "type": "float",
      "min": 0.1,
      "max": 1.0,
      "step": 0.05,
      "default": 0.8,
      "bind": "/1/inputs/top_p"
    },
    {
      "key": "repetition_penalty",
      "label": "Repetition penalty",
      "type": "float",
      "min": 1.0,
      "max": 2.0,
      "step": 0.05,
      "default": 1.1,
      "bind": "/1/inputs/repetition_penalty"
    },
    {
      "key": "chunk_length",
      "label": "Chunk length",
      "type": "int",
      "min": 20,
      "max": 400,
      "default": 200,
      "bind": "/1/inputs/chunk_length"
    }
  ]
}
